# SentinelTrade - modelo de variáveis de ambiente

# --- Aplicação ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Banco de dados ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sentinel_trade

# --- Segurança e autenticação (MFA) ---
SECRET_KEY=troque-esta-chave
MFA_ISSUER=SentinelTrade
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15

# --- Provedor de cotações (simulado) ---
QUOTES_PROVIDER_URL=http://localhost:9001
QUOTES_API_KEY=troque-esta-chave
QUOTES_STALE_SECONDS=5

# --- Bolsa/Corretora simulada ---
EXCHANGE_URL=http://localhost:9002
EXCHANGE_API_KEY=troque-esta-chave
EXCHANGE_TIMEOUT_SECONDS=3

# --- Circuit breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# --- Pregão simulado (horário local) ---
MARKET_OPEN_TIME=10:00
MARKET_CLOSE_TIME=17:00

# --- Notificações (MFA por e-mail e avisos ao investidor) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_SENDER=no-reply@orioncapital.example
